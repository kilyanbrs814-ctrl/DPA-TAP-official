{%- comment -%}
  Section : Offre professionnelle multisite (réseaux · franchises · multisites).
  Placée sur l'accueil entre la section d'achat (buy) et l'installation (install).
  CSS entièrement scopé sous « .pro-net ». Réutilise les classes globales du thème
  (.container, .btn, .btn--paper, .reveal) pour rester fidèle à la DA existante.
{%- endcomment -%}

<section class="pro-net" aria-labelledby="pro-net-title-{{ section.id }}">
  <div class="container">
    <div class="pro-net__card reveal">
      <div class="pro-net__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pro-net__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="pro-net__title" id="pro-net-title-{{ section.id }}">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <p class="pro-net__text">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.settings.reassure_1_enabled or section.settings.reassure_2_enabled or section.settings.reassure_3_enabled -%}
          <ul class="pro-net__chips">
            {%- if section.settings.reassure_1_enabled and section.settings.reassure_1_text != blank -%}
              <li class="pro-net__chip">
                <svg class="pro-net__chip-ico" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8.05 13.6 4.7 10.25l-1.25 1.25 4.6 4.6 8.5-8.5-1.25-1.25z" fill="currentColor"/></svg>
                <span>{{ section.settings.reassure_1_text }}</span>
              </li>
            {%- endif -%}
            {%- if section.settings.reassure_2_enabled and section.settings.reassure_2_text != blank -%}
              <li class="pro-net__chip">
                <svg class="pro-net__chip-ico" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8.05 13.6 4.7 10.25l-1.25 1.25 4.6 4.6 8.5-8.5-1.25-1.25z" fill="currentColor"/></svg>
                <span>{{ section.settings.reassure_2_text }}</span>
              </li>
            {%- endif -%}
            {%- if section.settings.reassure_3_enabled and section.settings.reassure_3_text != blank -%}
              <li class="pro-net__chip">
                <svg class="pro-net__chip-ico" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8.05 13.6 4.7 10.25l-1.25 1.25 4.6 4.6 8.5-8.5-1.25-1.25z" fill="currentColor"/></svg>
                <span>{{ section.settings.reassure_3_text }}</span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <div class="pro-net__cta">
          <a class="btn btn--paper pro-net__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.pro-net{background:var(--c-paper);padding:clamp(64px,9vw,110px) 0}
.pro-net__card{position:relative;overflow:clip;background:var(--c-bg);color:var(--c-paper);border:1px solid rgba(255,255,255,.08);border-radius:clamp(20px,3vw,28px);padding:clamp(28px,5vw,56px);display:grid;grid-template-columns:1fr auto;gap:clamp(24px,4vw,48px);align-items:center;box-shadow:0 40px 90px -50px rgba(66,133,244,.45)}
.pro-net__card::before{content:"";position:absolute;top:-40%;right:-8%;width:55%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--g-blue) 20%,transparent),transparent 65%);filter:blur(30px);pointer-events:none;z-index:0}
.pro-net__body{position:relative;z-index:1;min-width:0}
.pro-net__eyebrow{margin:0 0 12px;font-family:"Space Grotesk",Helvetica,Arial,sans-serif;font-size:.78rem;font-weight:600;line-height:1.4;letter-spacing:.2em;text-transform:uppercase;color:var(--g-blue);overflow-wrap:anywhere}
.pro-net__title{margin:0;max-width:24ch;font-size:clamp(1.55rem,1.15rem + 1.9vw,2.3rem);line-height:1.06;color:var(--c-paper)}
.pro-net__text{margin:16px 0 0;max-width:54ch;font-size:clamp(1rem,.96rem + .3vw,1.1rem);line-height:1.6;color:color-mix(in srgb,var(--c-paper) 76%,transparent)}
.pro-net__chips{list-style:none;margin:24px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:10px}
.pro-net__chip{display:inline-flex;align-items:center;gap:8px;padding:9px 16px;border-radius:999px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);font-family:"Space Grotesk",Helvetica,Arial,sans-serif;font-weight:500;font-size:.85rem;line-height:1.25;color:color-mix(in srgb,var(--c-paper) 88%,transparent)}
.pro-net__chip-ico{flex:none;color:var(--g-blue)}
.pro-net__cta{position:relative;z-index:1;flex:none}
.pro-net__btn{white-space:nowrap}
@media (max-width:860px){
  .pro-net__card{grid-template-columns:1fr;gap:26px;align-items:start}
  .pro-net__cta{width:100%}
  .pro-net__btn{width:100%}
}
@media (max-width:430px){
  .pro-net__chips{gap:8px}
  .pro-net__chip{width:100%;justify-content:flex-start}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Offre pro multisite",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre (eyebrow)",
      "default": "RÉSEAUX · FRANCHISES · MULTISITES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre (H2)",
      "default": "Plusieurs établissements ? Équipez tout votre réseau."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Dès 5 plaques, profitez de tarifs dégressifs, choisissez vos couleurs et associez un lien Google différent à chaque établissement."
    },
    {
      "type": "header",
      "content": "Éléments de réassurance"
    },
    {
      "type": "checkbox",
      "id": "reassure_1_enabled",
      "label": "Afficher l'élément 1",
      "default": true
    },
    {
      "type": "text",
      "id": "reassure_1_text",
      "label": "Élément 1",
      "default": "Dès 5 plaques"
    },
    {
      "type": "checkbox",
      "id": "reassure_2_enabled",
      "label": "Afficher l'élément 2",
      "default": true
    },
    {
      "type": "text",
      "id": "reassure_2_text",
      "label": "Élément 2",
      "default": "Un lien Google par établissement"
    },
    {
      "type": "checkbox",
      "id": "reassure_3_enabled",
      "label": "Afficher l'élément 3",
      "default": true
    },
    {
      "type": "text",
      "id": "reassure_3_text",
      "label": "Élément 3",
      "default": "Tarifs dégressifs"
    },
    {
      "type": "header",
      "content": "Bouton"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton",
      "default": "Découvrir l’offre professionnelle"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton",
      "default": "/pages/offre-professionnelle"
    }
  ],
  "presets": [
    {
      "name": "Offre pro multisite"
    }
  ]
}
{% endschema %}
