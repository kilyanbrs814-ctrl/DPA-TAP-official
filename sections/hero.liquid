{%- liquid
  assign hero_product = section.settings.product
  assign hero_reviews_link = section.settings.reviews_link | default: '#avis-clients'
-%}

<section class="lp-hero" aria-labelledby="lp-hero-title-{{ section.id }}">
  <div class="lp-hero__grid" aria-hidden="true"></div>
  <div class="lp-hero__glow lp-hero__glow--one" aria-hidden="true"></div>
  <div class="lp-hero__glow lp-hero__glow--two" aria-hidden="true"></div>

  <div class="container lp-hero__inner">
    <div class="lp-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lp-hero__eyebrow reveal">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="lp-hero__title reveal" id="lp-hero-title-{{ section.id }}">
        <span>{{ section.settings.title_line1 | default: 'Soyez plus visible sur Google.' }}</span>
        <em>{{ section.settings.title_line2 | default: 'Devenez le choix évident.' }}</em>
      </h1>

      <p class="lp-hero__subtitle reveal">
        {{ section.settings.subtitle | default: 'Vos futurs clients vous comparent déjà. DPA TAP facilite la collecte d’avis authentiques pour renforcer votre réputation, inspirer confiance et augmenter vos chances d’être choisi.' }}
      </p>

      <div class="lp-hero__actions reveal">
        <a class="btn lp-hero__primary" href="{{ section.settings.cta1_link | default: '#modeles' }}">
          {{ section.settings.cta1_label | default: 'Améliorer ma présence Google' }}
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn lp-hero__secondary" href="{{ section.settings.cta2_link | default: '#fonctionnement' }}">
          {{ section.settings.cta2_label | default: 'Voir la plaque en action' }}
        </a>
      </div>

      <ul class="lp-hero__trust reveal" aria-label="Avantages de la plaque DPA TAP">
        <li><span aria-hidden="true">✓</span> Sans abonnement</li>
        <li><span aria-hidden="true">✓</span> Prête à l’emploi</li>
        <li><span aria-hidden="true">✓</span> Garantie à vie</li>
      </ul>

      {%- if hero_product != blank -%}
        <div class="lp-hero__rating reveal">
          {%- render 'judgeme-badge', product: hero_product, variant: 'hero', href: hero_reviews_link -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="lp-hero__sectors reveal" aria-label="Secteurs compatibles">
        <span class="lp-hero__sectors-label">Pensée pour les commerces locaux</span>
        <ul>
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.label }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="lp-hero__stage reveal">
      <div class="lp-hero__stage-copy">
        <span class="lp-hero__stage-kicker">DPA TAP · PLAQUE NFC AVIS GOOGLE</span>
        <strong>Un client satisfait.<br>Un geste. Un avis.</strong>
        <span>La page Google s’ouvre directement, sans application.</span>
      </div>

      <figure class="lp-hero__demo">
        {%- if section.settings.visual != blank -%}
          {%- assign visual_alt = section.settings.visual.alt | default: 'Téléphone ouvrant la page d’avis Google grâce à la plaque NFC DPA TAP' -%}
          {{
            section.settings.visual
            | image_url: width: 1200
            | image_tag:
              widths: '480, 760, 960, 1200',
              sizes: '(max-width: 760px) calc(100vw - 48px), 560px',
              alt: visual_alt,
              class: 'lp-hero__demo-image',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- else -%}
          <img class="lp-hero__demo-image" src="{{ 'demo-plaque-nfc-poster.webp' | asset_url }}" width="1080" height="1350" alt="Téléphone ouvrant la page d’avis Google grâce à la plaque NFC DPA TAP" loading="eager" fetchpriority="high">
        {%- endif -%}
      </figure>

      <div class="lp-hero__product-card">
        <img src="{{ 'plaque-noire.jpg' | asset_url }}" width="1254" height="1254" alt="Plaque NFC Avis Google noire DPA TAP" loading="eager">
        <span><strong>Plaque NFC DPA TAP</strong>Programmée avant l’expédition</span>
      </div>

      <div class="lp-hero__google-card" aria-label="Résultat attendu pour la présence Google">
        <span class="lp-hero__google-g" aria-hidden="true">G</span>
        <span><strong>Une fiche plus rassurante</strong>Avis récents · confiance · choix</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero visibilité Google",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "POUR LES COMMERCES QUI VEULENT ÊTRE CHOISIS SUR GOOGLE" },
    { "type": "text", "id": "title_line1", "label": "Titre — ligne 1", "default": "Soyez plus visible sur Google." },
    { "type": "text", "id": "title_line2", "label": "Titre — ligne 2", "default": "Devenez le choix évident." },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Vos futurs clients vous comparent déjà. DPA TAP facilite la collecte d’avis authentiques pour renforcer votre réputation, inspirer confiance et augmenter vos chances d’être choisi." },
    { "type": "text", "id": "cta1_label", "label": "Bouton principal — libellé", "default": "Améliorer ma présence Google" },
    { "type": "url", "id": "cta1_link", "label": "Bouton principal — lien" },
    { "type": "text", "id": "cta2_label", "label": "Bouton secondaire — libellé", "default": "Voir la plaque en action" },
    { "type": "url", "id": "cta2_link", "label": "Bouton secondaire — lien" },
    { "type": "image_picker", "id": "visual", "label": "Démonstration du hero", "info": "Laisser vide pour utiliser la vraie démonstration téléphone + plaque livrée avec le thème." },
    { "type": "product", "id": "product", "label": "Produit du badge d’avis" },
    { "type": "url", "id": "reviews_link", "label": "Lien du badge d’avis" }
  ],
  "blocks": [
    {
      "type": "sector",
      "name": "Secteur",
      "settings": [
        { "type": "text", "id": "label", "label": "Libellé", "default": "Restaurant" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hero visibilité Google",
      "blocks": [
        { "type": "sector", "settings": { "label": "Restaurant" } },
        { "type": "sector", "settings": { "label": "Coiffeur" } },
        { "type": "sector", "settings": { "label": "Institut" } },
        { "type": "sector", "settings": { "label": "Hôtel" } },
        { "type": "sector", "settings": { "label": "Garage" } },
        { "type": "sector", "settings": { "label": "+ de commerces" } }
      ]
    }
  ]
}
{% endschema %}
