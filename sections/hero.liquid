{%- liquid
  assign hero_product = section.settings.product
  assign hero_reviews_link = section.settings.reviews_link | default: '#avis-clients'
-%}

<section class="lp-hero" aria-labelledby="lp-hero-title-{{ section.id }}">
  <div class="lp-hero__grid" aria-hidden="true"></div>
  <div class="lp-hero__glow lp-hero__glow--one" aria-hidden="true"></div>
  <div class="lp-hero__glow lp-hero__glow--two" aria-hidden="true"></div>

  <div class="container lp-hero__inner">
    <div class="lp-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lp-hero__eyebrow reveal">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="lp-hero__title reveal" id="lp-hero-title-{{ section.id }}">
        <span>{{ section.settings.title_line1 | default: 'Soyez plus visible sur Google.' }}</span>
        <em>{{ section.settings.title_line2 | default: 'Devenez le choix évident.' }}</em>
      </h1>

      <p class="lp-hero__subtitle reveal">
        {{ section.settings.subtitle | default: 'Vos futurs clients vous comparent déjà. DPA TAP facilite la collecte d’avis authentiques pour renforcer votre réputation, inspirer confiance et augmenter vos chances d’être choisi.' }}
      </p>

      <div class="lp-hero__actions reveal">
        <a class="btn lp-hero__primary" href="{{ section.settings.cta1_link | default: '#modeles' }}">
          <span class="lp-hero__cta-label">{{ section.settings.cta1_label | default: 'Améliorer ma présence Google' }}</span>
        </a>
        <a class="btn lp-hero__secondary" href="{{ section.settings.cta2_link | default: '#fonctionnement' }}">
          <span class="lp-hero__cta-label">{{ section.settings.cta2_label | default: 'Voir la plaque en action' }}</span>
        </a>
      </div>

      <ul class="lp-hero__trust reveal" aria-label="Avantages de la plaque DPA TAP">
        <li><span aria-hidden="true">✓</span> Sans abonnement</li>
        <li><span aria-hidden="true">✓</span> Prête à l’emploi</li>
        <li><span aria-hidden="true">✓</span> Garantie à vie</li>
      </ul>

      {%- if hero_product != blank -%}
        <div class="lp-hero__rating reveal">
          {%- render 'judgeme-badge', product: hero_product, variant: 'hero', href: hero_reviews_link -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="lp-hero__sectors reveal" id="HeroSectors-{{ section.id }}" data-sector-tabs>
        <span class="lp-hero__sectors-label">Pensée pour les commerces locaux</span>
        <ul role="tablist" aria-label="Voir un exemple par secteur">
          {%- for block in section.blocks -%}
            <li role="presentation">
              <button
                type="button"
                id="SectorTab-{{ section.id }}-{{ block.id }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="SectorPanel-{{ section.id }}-{{ block.id }}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-sector-tab="{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
        <div class="lp-hero__sector-showcase">
          {%- for block in section.blocks -%}
            {%- liquid
              assign sector_key = block.settings.label | handleize
              case sector_key
                when 'restaurant'
                  assign fallback_visual = 'sector-restaurant.webp'
                  assign fallback_alt = 'Exemple fictif de fiche Google pour le restaurant Le Jardin d’Ambre'
                when 'coiffeur'
                  assign fallback_visual = 'sector-coiffeur.webp'
                  assign fallback_alt = 'Exemple fictif de fiche Google pour le salon Studio Miroir'
                when 'institut'
                  assign fallback_visual = 'sector-institut.webp'
                  assign fallback_alt = 'Exemple fictif de fiche Google pour l’institut Maison Éclat'
                when 'hotel'
                  assign fallback_visual = 'sector-hotel.webp'
                  assign fallback_alt = 'Exemple fictif de fiche Google pour Hôtel Rivage'
                when 'garage'
                  assign fallback_visual = 'sector-garage.webp'
                  assign fallback_alt = 'Exemple fictif de fiche Google pour Garage Atlas'
                else
                  assign fallback_visual = 'sector-autres.webp'
                  assign fallback_alt = 'Exemple fictif de fiche Google pour la boutique de vêtements Maison Noma'
              endcase
              assign sector_alt = block.settings.image.alt | default: block.settings.alt | default: fallback_alt
            -%}
            <figure
              class="lp-hero__sector-panel{% if forloop.first %} is-active{% endif %}"
              id="SectorPanel-{{ section.id }}-{{ block.id }}"
              role="tabpanel"
              aria-labelledby="SectorTab-{{ section.id }}-{{ block.id }}"
              data-sector-panel="{{ block.id }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1800
                  | image_tag:
                    widths: '600, 900, 1200, 1500, 1800',
                    sizes: '(max-width: 760px) calc(100vw - 32px), min(1200px, calc(100vw - 80px))',
                    alt: sector_alt,
                    class: 'lp-hero__sector-image',
                    loading: 'lazy'
                }}
              {%- else -%}
                <img
                  class="lp-hero__sector-image"
                  src="{{ fallback_visual | asset_url }}"
                  width="1774"
                  height="800"
                  alt="{{ sector_alt | escape }}"
                  {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                >
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('HeroSectors-{{ section.id }}');
    if (!root || root.dataset.tabsReady === 'true') return;
    root.dataset.tabsReady = 'true';

    const tabs = Array.from(root.querySelectorAll('[data-sector-tab]'));
    const panels = Array.from(root.querySelectorAll('[data-sector-panel]'));

    const activate = (id, focusTab = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.sectorTab === id;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
        if (active && focusTab) tab.focus();
      });
      panels.forEach((panel) => {
        const active = panel.dataset.sectorPanel === id;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab.dataset.sectorTab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = tabs.length - 1;
        activate(tabs[next].dataset.sectorTab, true);
      });
    });

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:block:select', (event) => {
        const selected = event.target.matches('[data-sector-tab]')
          ? event.target
          : event.target.querySelector('[data-sector-tab]');
        if (selected && root.contains(selected)) activate(selected.dataset.sectorTab);
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Hero visibilité Google",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "POUR LES COMMERCES QUI VEULENT ÊTRE CHOISIS SUR GOOGLE" },
    { "type": "text", "id": "title_line1", "label": "Titre — ligne 1", "default": "Soyez plus visible sur Google." },
    { "type": "text", "id": "title_line2", "label": "Titre — ligne 2", "default": "Devenez le choix évident." },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Vos futurs clients vous comparent déjà. DPA TAP facilite la collecte d’avis authentiques pour renforcer votre réputation, inspirer confiance et augmenter vos chances d’être choisi." },
    { "type": "text", "id": "cta1_label", "label": "Bouton principal — libellé", "default": "Améliorer ma présence Google" },
    { "type": "url", "id": "cta1_link", "label": "Bouton principal — lien" },
    { "type": "text", "id": "cta2_label", "label": "Bouton secondaire — libellé", "default": "Voir la plaque en action" },
    { "type": "url", "id": "cta2_link", "label": "Bouton secondaire — lien" },
    { "type": "product", "id": "product", "label": "Produit du badge d’avis" },
    { "type": "url", "id": "reviews_link", "label": "Lien du badge d’avis" }
  ],
  "blocks": [
    {
      "type": "sector",
      "name": "Secteur",
      "settings": [
        { "type": "text", "id": "label", "label": "Libellé", "default": "Restaurant" },
        { "type": "image_picker", "id": "image", "label": "Visuel du secteur", "info": "Laisser vide pour utiliser le visuel fictif livré avec le thème." },
        { "type": "text", "id": "alt", "label": "Texte alternatif de l’image" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hero visibilité Google",
      "blocks": [
        { "type": "sector", "settings": { "label": "Restaurant" } },
        { "type": "sector", "settings": { "label": "Coiffeur" } },
        { "type": "sector", "settings": { "label": "Institut" } },
        { "type": "sector", "settings": { "label": "Hôtel" } },
        { "type": "sector", "settings": { "label": "Garage" } },
        { "type": "sector", "settings": { "label": "Autres" } }
      ]
    }
  ]
}
{% endschema %}
