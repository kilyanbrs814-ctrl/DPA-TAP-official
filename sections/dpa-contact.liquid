{%- comment -%}
  Section : carte de contact DPA (page /pages/contact).

  Portage Liquid du design Claude Design « Demo Yanis Barber.dc.html » (nom de
  fichier historique — le contenu est la carte de contact de Kilyan Bouras).
  Toutes les dépendances Claude Design ont été retirées : plus de <x-dc>,
  <helmet>, DCLogic, image-slot.js ni support.js. Le rendu est natif au thème.

  Le CSS est entièrement scopé sous « .dpa-contact ». Les couleurs viennent des
  variables globales du thème (--c-bg, --c-paper, --g-blue) : la carte reprend
  donc automatiquement le bleu officiel #4285F4.

  Les animations d'entrée réutilisent la classe globale `.reveal` (theme.js), qui
  respecte déjà `prefers-reduced-motion`.
{%- endcomment -%}

{%- liquid
  assign full_name  = section.settings.full_name  | default: 'Kilyan Bouras'
  assign job_title  = section.settings.job_title  | default: 'Fondateur'
  assign company    = section.settings.company    | default: 'Digital Project Agency'
  assign phone      = section.settings.phone      | default: '+33 7 53 80 14 15'
  assign email      = section.settings.email      | default: 'contact@digitalprojectagency.fr'
  assign whatsapp   = section.settings.whatsapp   | default: '+33 7 53 80 14 15'
  assign agency_url = section.settings.agency_url | default: 'https://digitalprojectagency.fr'
  assign location   = section.settings.location   | default: 'Tarn · Occitanie · Projets partout en France'

  comment
    Seule la valeur du paramètre est encodée, jamais l'URL complète. `url_encode`
    remplace les espaces par « + » : ils sont reconvertis en « %20 », que
    WhatsApp comme les clients e-mail interprètent sans ambiguïté.
  endcomment
  assign wa_digits    = whatsapp | remove: ' ' | remove: '+' | remove: '.' | remove: '-' | remove: '(' | remove: ')'
  assign tel_href     = phone | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')'
  assign wa_message   = section.settings.whatsapp_message | default: "Bonjour Kilyan, je viens de scanner votre carte NFC et j’aimerais échanger avec vous au sujet de mon projet."
  assign mail_subject = section.settings.email_subject | default: 'Demande de projet — Carte NFC'
  assign wa_text      = wa_message | url_encode | replace: '+', '%20'
  assign mail_subj    = mail_subject | url_encode | replace: '+', '%20'
  assign wa_href      = 'https://wa.me/' | append: wa_digits | append: '?text=' | append: wa_text
  assign mail_href    = 'mailto:' | append: email | append: '?subject=' | append: mail_subj

  assign agency_label = agency_url | remove: 'https://' | remove: 'http://' | remove: 'www.' | split: '/' | first
-%}

{%- comment -%} Instrument Sans n'est chargée que sur cette page. {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" media="print" onload="this.media='all';this.onload=null">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"></noscript>

<section class="dpa-contact" id="dpa-contact-{{ section.id }}" data-dpa-contact>
  <main class="dpa-contact__card">

    {%- comment -%} ============ HERO ============ {%- endcomment -%}
    <header class="dpa-contact__hero">
      <span class="dpa-contact__glow" aria-hidden="true"></span>
      <span class="dpa-contact__orb" aria-hidden="true"></span>
      <span class="dpa-contact__grid" aria-hidden="true"></span>

      <div class="dpa-contact__hero-inner">
        {%- if section.settings.logo != blank -%}
          <img
            class="dpa-contact__logo"
            src="{{ section.settings.logo | image_url: width: 480 }}"
            alt="{{ company | escape }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            loading="eager"
            fetchpriority="high">
        {%- else -%}
          <img
            class="dpa-contact__logo"
            src="{{ 'logo-dpa-tap-white.png' | asset_url }}"
            alt="{{ company | escape }}"
            width="414"
            height="84"
            loading="eager"
            fetchpriority="high">
        {%- endif -%}

        <h1 class="dpa-contact__name">{{ full_name }}</h1>
        <p class="dpa-contact__role">{{ job_title | upcase }} · {{ company | upcase }}</p>

        {%- if section.settings.intro != blank -%}
          <p class="dpa-contact__intro">{{ section.settings.intro }}</p>
        {%- endif -%}

        {%- if section.settings.show_available -%}
          <p class="dpa-contact__pill">
            <span class="dpa-contact__dot" aria-hidden="true"></span>
            {{ section.settings.available_text | default: 'Disponible pour échanger sur votre projet' }}
          </p>
        {%- endif -%}
      </div>
    </header>

    {%- comment -%} ============ ACTIONS ============ {%- endcomment -%}
    <div class="dpa-contact__actions">
      <button type="button" class="dpa-contact__act dpa-contact__act--primary" data-dpa-vcard>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M3.5 20c.8-3.2 2.9-5 5.5-5s4.7 1.8 5.5 5"/><path d="M18 8v6M15 11h6"/></svg>
        <span>Ajouter aux contacts</span>
      </button>

      {%- if wa_digits != blank -%}
        <a class="dpa-contact__act" href="{{ wa_href }}" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          <span>WhatsApp</span>
        </a>
      {%- endif -%}

      {%- if email != blank -%}
        <a class="dpa-contact__act" href="{{ mail_href }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="3"/><path d="M3 7l9 6 9-6"/></svg>
          <span>E-mail</span>
        </a>
      {%- endif -%}

      {%- if agency_url != blank -%}
        <a class="dpa-contact__act" href="{{ agency_url }}" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.4 3.8 5.5 3.8 9S14.5 18.6 12 21c-2.5-2.4-3.8-5.5-3.8-9S9.5 5.4 12 3z"/></svg>
          <span>Visiter mon site</span>
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} ============ DPA TAP (affiché seulement si un lien est renseigné) ============ {%- endcomment -%}
    {%- if section.settings.dpatap_url != blank -%}
      <div class="dpa-contact__block">
        <a class="dpa-contact__promo" href="{{ section.settings.dpatap_url }}">
          <span class="dpa-contact__promo-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M8.5 9.5a4.5 4.5 0 0 1 0 5.5"/><path d="M11.5 7a8 8 0 0 1 0 10.5"/><path d="M14.5 4.5a11.5 11.5 0 0 1 0 15.5"/></svg>
          </span>
          <span class="dpa-contact__promo-txt">
            <span class="dpa-contact__promo-title">Découvrir DPA Tap</span>
            <span class="dpa-contact__promo-sub">La solution NFC pour obtenir plus d'avis Google</span>
          </span>
          <svg class="dpa-contact__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </div>
    {%- endif -%}

    {%- comment -%} ============ LIENS ============ {%- endcomment -%}
    <div class="dpa-contact__block">
      <h2 class="dpa-contact__eyebrow">LIENS</h2>
      <div class="dpa-contact__links">
        {%- if agency_url != blank -%}
          <a class="dpa-contact__link reveal" href="{{ agency_url }}" target="_blank" rel="noopener noreferrer">
            <span class="dpa-contact__link-ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.4 3.8 5.5 3.8 9S14.5 18.6 12 21c-2.5-2.4-3.8-5.5-3.8-9S9.5 5.4 12 3z"/></svg>
            </span>
            <span class="dpa-contact__link-txt"><span class="dpa-contact__link-title">{{ company }}</span><span class="dpa-contact__link-sub">{{ agency_label }}</span></span>
            <svg class="dpa-contact__chev dpa-contact__chev--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}

        {%- if section.settings.dpatap_url != blank -%}
          <a class="dpa-contact__link reveal" href="{{ section.settings.dpatap_url }}">
            <span class="dpa-contact__link-ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M8.5 9.5a4.5 4.5 0 0 1 0 5.5"/><path d="M11.5 7a8 8 0 0 1 0 10.5"/><path d="M14.5 4.5a11.5 11.5 0 0 1 0 15.5"/></svg>
            </span>
            <span class="dpa-contact__link-txt"><span class="dpa-contact__link-title">DPA Tap</span><span class="dpa-contact__link-sub">{{ section.settings.dpatap_label | default: 'Plaque NFC avis Google' }}</span></span>
            <svg class="dpa-contact__chev dpa-contact__chev--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}

        {%- if section.settings.instagram_url != blank -%}
          <a class="dpa-contact__link reveal" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer">
            <span class="dpa-contact__link-ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r=".9" fill="currentColor" stroke="none"/></svg>
            </span>
            <span class="dpa-contact__link-txt"><span class="dpa-contact__link-title">Instagram</span><span class="dpa-contact__link-sub">{{ section.settings.instagram_label }}</span></span>
            <svg class="dpa-contact__chev dpa-contact__chev--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}

        {%- if section.settings.facebook_url != blank -%}
          <a class="dpa-contact__link reveal" href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer">
            <span class="dpa-contact__link-ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 8.5V6.8c0-.9.4-1.3 1.4-1.3H17.5V2.6h-2.6c-2.7 0-3.9 1.5-3.9 3.9v2h-2v3h2V21h3.5v-9.5H17l.5-3h-3z"/></svg>
            </span>
            <span class="dpa-contact__link-txt"><span class="dpa-contact__link-title">Facebook</span><span class="dpa-contact__link-sub">{{ section.settings.facebook_label }}</span></span>
            <svg class="dpa-contact__chev dpa-contact__chev--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}

        {%- if section.settings.tiktok_url != blank -%}
          <a class="dpa-contact__link reveal" href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer">
            <span class="dpa-contact__link-ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8.5" cy="16.5" r="3.6"/><path d="M12.1 16.5V3.6c1 2.6 2.9 4.3 6 4.6"/></svg>
            </span>
            <span class="dpa-contact__link-txt"><span class="dpa-contact__link-title">TikTok</span><span class="dpa-contact__link-sub">{{ section.settings.tiktok_label }}</span></span>
            <svg class="dpa-contact__chev dpa-contact__chev--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}

        {%- if section.settings.linkedin_url != blank -%}
          <a class="dpa-contact__link reveal" href="{{ section.settings.linkedin_url }}" target="_blank" rel="noopener noreferrer">
            <span class="dpa-contact__link-ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="4"/><path d="M7 10.5V17M7 7.2v.1M11.5 17v-3.6a2.4 2.4 0 0 1 4.8 0V17"/></svg>
            </span>
            <span class="dpa-contact__link-txt"><span class="dpa-contact__link-title">LinkedIn</span><span class="dpa-contact__link-sub">{{ section.settings.linkedin_label }}</span></span>
            <svg class="dpa-contact__chev dpa-contact__chev--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ============ MES SOLUTIONS ============ {%- endcomment -%}
    <div class="dpa-contact__block dpa-contact__block--lg">
      <h2 class="dpa-contact__eyebrow">MES SOLUTIONS</h2>
      <div class="dpa-contact__solutions reveal">
        <div class="dpa-contact__solution">
          <span class="dpa-contact__solution-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="19" height="14" rx="2.5"/><path d="M2.5 8.5h19M6 6.2v.1M8.4 6.2v.1"/></svg>
          </span>
          <span class="dpa-contact__solution-txt">
            <span class="dpa-contact__solution-title">Création de sites web</span>
            <span class="dpa-contact__solution-sub">Des sites professionnels, modernes et adaptés à votre activité pour présenter votre entreprise et convertir vos visiteurs en clients.</span>
          </span>
        </div>

        <div class="dpa-contact__solution">
          <span class="dpa-contact__solution-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.4 15.4L21 21"/></svg>
          </span>
          <span class="dpa-contact__solution-txt">
            <span class="dpa-contact__solution-title">Référencement SEO</span>
            <span class="dpa-contact__solution-sub">Une optimisation de votre site et de vos contenus pour améliorer votre visibilité dans les résultats Google.</span>
          </span>
        </div>

        <div class="dpa-contact__solution">
          <span class="dpa-contact__solution-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h7.5L19 8.5V21H6z"/><path d="M13.2 3v5.8H19"/><path d="M9 13h6M9 16.5h4"/></svg>
          </span>
          <span class="dpa-contact__solution-txt">
            <span class="dpa-contact__solution-title">Création de flyers</span>
            <span class="dpa-contact__solution-sub">Des flyers professionnels et cohérents avec votre image pour présenter vos offres, événements ou services.</span>
          </span>
        </div>

        <div class="dpa-contact__solution">
          <span class="dpa-contact__solution-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.1"/><rect x="11.4" y="11.4" width="9.1" height="9.1" rx="2.2"/></svg>
          </span>
          <span class="dpa-contact__solution-txt">
            <span class="dpa-contact__solution-title">Création de logos</span>
            <span class="dpa-contact__solution-sub">Une identité visuelle claire et professionnelle pour rendre votre entreprise immédiatement reconnaissable.</span>
          </span>
        </div>

        <div class="dpa-contact__solution dpa-contact__solution--accent">
          <span class="dpa-contact__solution-ico dpa-contact__solution-ico--accent">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M8.5 9.5a4.5 4.5 0 0 1 0 5.5"/><path d="M11.5 7a8 8 0 0 1 0 10.5"/><path d="M14.5 4.5a11.5 11.5 0 0 1 0 15.5"/></svg>
          </span>
          <span class="dpa-contact__solution-txt">
            <span class="dpa-contact__solution-title">DPA Tap | Plaque avis Google</span>
            <span class="dpa-contact__solution-sub">Des plaques NFC permettant à vos clients d'accéder facilement à votre page d'avis Google et de laisser un avis en quelques secondes.</span>
          </span>
        </div>
      </div>
    </div>

    {%- comment -%} ============ CONVERSION ============ {%- endcomment -%}
    <div class="dpa-contact__block">
      <div class="dpa-contact__cta reveal">
        <span class="dpa-contact__cta-orb" aria-hidden="true"></span>
        <div class="dpa-contact__cta-inner">
          <h2 class="dpa-contact__cta-title">Vous avez un projet&nbsp;?</h2>
          <p class="dpa-contact__cta-text">Expliquez-moi votre activité et votre objectif. Je vous réponds avec une solution claire et adaptée.</p>
          {%- if wa_digits != blank -%}
            <a class="dpa-contact__cta-btn" href="{{ wa_href }}" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              Discuter sur WhatsApp
            </a>
          {%- endif -%}
          {%- if email != blank -%}
            <div class="dpa-contact__cta-alt"><a class="dpa-contact__cta-ghost" href="{{ mail_href }}">Envoyer un e-mail</a></div>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} ============ À PROPOS ============ {%- endcomment -%}
    {%- if section.settings.about != blank -%}
      <div class="dpa-contact__block dpa-contact__block--lg">
        <h2 class="dpa-contact__eyebrow">À PROPOS</h2>
        <p class="dpa-contact__about reveal">{{ section.settings.about }}</p>
      </div>
    {%- endif -%}

    {%- comment -%} ============ CONTACT ============ {%- endcomment -%}
    <div class="dpa-contact__block dpa-contact__block--lg">
      <h2 class="dpa-contact__eyebrow">CONTACT</h2>
      <div class="dpa-contact__rows reveal">
        {%- if phone != blank -%}
          <a class="dpa-contact__row" href="tel:{{ tel_href }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{{ phone }}</span>
          </a>
        {%- endif -%}
        {%- if email != blank -%}
          <a class="dpa-contact__row" href="{{ mail_href }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="3"/><path d="M3 7l9 6 9-6"/></svg>
            <span class="dpa-contact__row-wrap">{{ email }}</span>
          </a>
        {%- endif -%}
        {%- if agency_url != blank -%}
          <a class="dpa-contact__row" href="{{ agency_url }}" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.4 3.8 5.5 3.8 9S14.5 18.6 12 21c-2.5-2.4-3.8-5.5-3.8-9S9.5 5.4 12 3z"/></svg>
            <span class="dpa-contact__row-wrap">{{ agency_label }}</span>
          </a>
        {%- endif -%}
        {%- if location != blank -%}
          <div class="dpa-contact__row dpa-contact__row--static">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{{ location }}</span>
          </div>
        {%- endif -%}
        <div class="dpa-contact__row dpa-contact__row--static">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M3 9.5h18M8 3v3M16 3v3"/></svg>
          <span>{{ section.settings.appointment_text | default: 'Échange sur rendez-vous' }}</span>
        </div>
      </div>
    </div>

    {%- comment -%}
      Formulaire Shopify natif. Désactivé par défaut : le design de la carte
      dirige vers WhatsApp et l'e-mail. Il reste disponible en un clic dans
      l'éditeur de thème pour retrouver le formulaire de l'ancienne page Contact.
    {%- endcomment -%}
    {%- if section.settings.show_form -%}
      <div class="dpa-contact__block dpa-contact__block--lg">
        <h2 class="dpa-contact__eyebrow">{{ section.settings.form_title | default: 'NOUS ÉCRIRE' }}</h2>
        <div class="dpa-contact__form">
          {%- form 'contact' -%}
            {%- if form.posted_successfully? -%}
              <p class="dpa-contact__form-ok" role="status">Message envoyé. Nous répondons par e-mail, du lundi au vendredi.</p>
            {%- endif -%}
            {%- if form.errors -%}
              <p class="dpa-contact__form-error" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}
            <div class="dpa-contact__field">
              <label for="dpa-contact-name-{{ section.id }}">Nom</label>
              <input type="text" id="dpa-contact-name-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
            </div>
            <div class="dpa-contact__field">
              <label for="dpa-contact-email-{{ section.id }}">E-mail</label>
              <input type="email" id="dpa-contact-email-{{ section.id }}" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
            </div>
            <div class="dpa-contact__field">
              <label for="dpa-contact-body-{{ section.id }}">Message</label>
              <textarea id="dpa-contact-body-{{ section.id }}" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
            </div>
            <button type="submit" class="dpa-contact__cta-btn dpa-contact__form-btn">Envoyer le message</button>
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}
      Pied de page interne : il fait partie de la carte digitale (design Claude
      Design). Le pied de page principal du thème reste rendu par le gabarit.
    {%- endcomment -%}
    <footer class="dpa-contact__foot">
      {%- if section.settings.logo != blank -%}
        <img class="dpa-contact__foot-logo" src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ company | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" loading="lazy">
      {%- else -%}
        <img class="dpa-contact__foot-logo" src="{{ 'logo-dpa-tap-white.png' | asset_url }}" alt="{{ company | escape }}" width="414" height="84" loading="lazy">
      {%- endif -%}
      <span class="dpa-contact__foot-name">{{ company }}</span>
      <span class="dpa-contact__foot-sub">{{ section.settings.footer_tagline | default: 'Sites web · Visibilité · Solutions NFC' }}</span>
      <span class="dpa-contact__foot-nfc">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8.5 9.5a4.5 4.5 0 0 1 0 5.5"/><path d="M11.5 7a8 8 0 0 1 0 10.5"/><path d="M14.5 4.5a11.5 11.5 0 0 1 0 15.5"/></svg>
        Carte de contact NFC · {{ 'now' | date: '%Y' }}
      </span>
    </footer>
  </main>

  <script
    type="application/json"
    data-dpa-vcard-data>
    {
      "n": {{ full_name | json }},
      "title": {{ job_title | json }},
      "org": {{ company | json }},
      "tel": {{ phone | json }},
      "email": {{ email | json }},
      "url": {{ agency_url | json }},
      "wa": {{ wa_digits | json }},
      "dpatap": {{ section.settings.dpatap_url | json }},
      "note": {{ section.settings.vcard_note | default: 'Digital Project Agency — sites web, référencement SEO, flyers, logos et solutions NFC DPA Tap.' | json }},
      "file": "kilyan-bouras-dpa.vcf"
    }
  </script>
</section>

<script>
  (function () {
    var root = document.getElementById('dpa-contact-{{ section.id }}');
    if (!root || root.dataset.dpaContactReady === '1') return;
    root.dataset.dpaContactReady = '1';

    var btn = root.querySelector('[data-dpa-vcard]');
    var dataEl = root.querySelector('[data-dpa-vcard-data]');
    if (!btn || !dataEl) return;

    var cfg;
    try { cfg = JSON.parse(dataEl.textContent); } catch (e) { return; }

    function esc(v) {
      return String(v == null ? '' : v).replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n');
    }

    function buildVcard() {
      var parts = String(cfg.n || '').trim().split(/\s+/);
      var first = parts.shift() || '';
      var last = parts.join(' ');
      var lines = ['BEGIN:VCARD', 'VERSION:3.0'];
      lines.push('N:' + esc(last) + ';' + esc(first) + ';;;');
      lines.push('FN:' + esc(cfg.n));
      if (cfg.org) lines.push('ORG:' + esc(cfg.org));
      if (cfg.title) lines.push('TITLE:' + esc(cfg.title));
      if (cfg.tel) lines.push('TEL;TYPE=CELL,VOICE:' + esc(String(cfg.tel).replace(/\s+/g, '')));
      if (cfg.email) lines.push('EMAIL;TYPE=INTERNET,WORK:' + esc(cfg.email));
      if (cfg.url) lines.push('URL:' + esc(cfg.url));
      if (cfg.wa) {
        lines.push('item1.URL:https://wa.me/' + esc(cfg.wa));
        lines.push('item1.X-ABLabel:WhatsApp');
      }
      if (cfg.dpatap) {
        lines.push('item2.URL:' + esc(cfg.dpatap));
        lines.push('item2.X-ABLabel:DPA Tap');
      }
      if (cfg.note) lines.push('NOTE:' + esc(cfg.note));
      lines.push('END:VCARD');
      return lines.join('\r\n');
    }

    btn.addEventListener('click', function () {
      var blob = new Blob(['\ufeff' + buildVcard()], { type: 'text/vcard;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = cfg.file || 'contact.vcf';
      a.rel = 'noopener';
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 2000);
    });
  })();
</script>

{% stylesheet %}
/* ============ Carte de contact DPA (/pages/contact) ============ */
/* Tout est scopé sous « .dpa-contact ». La largeur de la carte est bornée à
   431 px comme dans le design d'origine ; en dessous de cette largeur elle
   occupe tout l'écran et perd ses coins arrondis, exactement comme la maquette.
   Le retrait haut reprend celui de `.page-pad` : il dégage l'en-tête fixe. */
.dpa-contact{
  --dpa-c-accent:var(--g-blue);
  --dpa-c-bg:var(--c-bg);
  --dpa-c-fg:var(--c-paper);
  --dpa-round:0px;
  --dpa-pad-x:18px;
  position:relative;
  isolation:isolate;
  background:
    radial-gradient(ellipse 85% 45% at 50% -8%,color-mix(in srgb,var(--dpa-c-accent) 10%,transparent),transparent 66%),
    radial-gradient(ellipse 70% 45% at 50% 108%,color-mix(in srgb,var(--dpa-c-accent) 7%,transparent),transparent 72%),
    var(--dpa-c-bg);
  color:var(--dpa-c-fg);
  padding:120px 0 0;
  font-family:"Instrument Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
  overflow-x:clip;
}
@media (min-width:432px){
  .dpa-contact{--dpa-round:30px;padding:120px 16px 48px}
}
@media (min-width:601px){
  .dpa-contact{padding:160px 16px 56px}
}
.dpa-contact *,.dpa-contact *::before,.dpa-contact *::after{box-sizing:border-box}
.dpa-contact ::selection{background:color-mix(in srgb,var(--dpa-c-accent) 30%,transparent)}
.dpa-contact a{color:var(--dpa-c-fg);text-decoration:none}
.dpa-contact img{max-width:100%}

.dpa-contact__card{
  position:relative;
  width:min(431px,100%);
  margin:0 auto;
  background:linear-gradient(180deg,#0F0F11 0%,#0A0A0B 45%);
  border:1px solid rgba(255,255,255,.07);
  border-radius:var(--dpa-round);
  box-shadow:0 60px 120px -40px rgba(0,0,0,.9);
  overflow:hidden;
}

/* ---- Hero ---- */
.dpa-contact__hero{position:relative;padding:26px 22px 22px;text-align:center}
.dpa-contact__glow,.dpa-contact__orb,.dpa-contact__grid{position:absolute;pointer-events:none}
.dpa-contact__glow{top:-140px;left:50%;transform:translateX(-50%);width:440px;height:300px;max-width:120%;background:radial-gradient(closest-side,color-mix(in srgb,var(--dpa-c-accent) 20%,transparent),transparent 72%)}
.dpa-contact__orb{top:-60px;right:-90px;width:260px;height:260px;border-radius:50%;background:radial-gradient(closest-side,color-mix(in srgb,var(--dpa-c-accent) 10%,transparent),transparent 70%)}
.dpa-contact__grid{inset:0;background-image:radial-gradient(rgba(255,255,255,.04) 1px,transparent 1px);background-size:24px 24px;-webkit-mask-image:linear-gradient(#000 25%,transparent 88%);mask-image:linear-gradient(#000 25%,transparent 88%)}
.dpa-contact__hero-inner{position:relative;display:flex;flex-direction:column;align-items:center}
.dpa-contact__logo{height:52px;width:auto;max-width:70%;object-fit:contain;display:block;opacity:.95;animation:dpaContactUp .7s cubic-bezier(.22,.61,.36,1) both}
.dpa-contact__name{margin:16px 0 0;font-family:"Space Grotesk",Helvetica,Arial,sans-serif;font-weight:600;font-size:29px;letter-spacing:-.02em;line-height:1.1;color:var(--dpa-c-fg);text-wrap:balance}
.dpa-contact__role{margin:9px 0 0;font:600 11px/1.4 "Space Grotesk",Helvetica,Arial,sans-serif;letter-spacing:.18em;color:var(--dpa-c-accent);overflow-wrap:anywhere}
.dpa-contact__intro{margin:13px auto 0;max-width:300px;font-size:14px;line-height:1.55;color:color-mix(in srgb,var(--dpa-c-fg) 60%,transparent);text-wrap:pretty}
.dpa-contact__pill{display:inline-flex;align-items:center;gap:8px;margin:14px auto 0;max-width:100%;font-size:12.5px;line-height:1.35;color:color-mix(in srgb,var(--dpa-c-fg) 72%,transparent);background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);padding:7px 14px;border-radius:999px;text-wrap:pretty}
.dpa-contact__dot{flex:none;width:7px;height:7px;border-radius:50%;background:var(--dpa-c-accent);box-shadow:0 0 9px var(--dpa-c-accent);animation:dpaContactDot 2.4s ease-in-out infinite}

/* ---- Actions ---- */
.dpa-contact__actions{padding:2px var(--dpa-pad-x) 0;display:flex;flex-wrap:wrap;gap:10px}
.dpa-contact__act{
  flex:1 1 calc(50% - 5px);min-width:calc(50% - 5px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;
  min-height:76px;padding:10px 12px;border-radius:18px;text-align:center;
  background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.09);
  color:var(--dpa-c-fg);font-family:inherit;cursor:pointer;
  transition:border-color .25s,background .25s,transform .15s,box-shadow .25s;
  animation:dpaContactUp .6s cubic-bezier(.22,.61,.36,1) both;
}
.dpa-contact__act svg{width:21px;height:21px;flex:none;color:var(--dpa-c-accent)}
.dpa-contact__act span{font:600 13.5px/1.25 "Instrument Sans",Helvetica,Arial,sans-serif;overflow-wrap:anywhere}
.dpa-contact__act:hover{border-color:color-mix(in srgb,var(--dpa-c-accent) 55%,transparent);background:rgba(255,255,255,.06);color:var(--dpa-c-fg)}
.dpa-contact__act:active{transform:scale(.97)}
.dpa-contact__act--primary{
  background:linear-gradient(140deg,var(--dpa-c-accent),color-mix(in srgb,var(--dpa-c-accent) 78%,#1F6FEB));
  border:none;color:var(--dpa-c-bg);
  box-shadow:0 12px 30px -12px color-mix(in srgb,var(--dpa-c-accent) 65%,transparent);
}
.dpa-contact__act--primary svg{color:var(--dpa-c-bg)}
.dpa-contact__act--primary:hover{color:var(--dpa-c-bg);background:linear-gradient(140deg,var(--dpa-c-accent),color-mix(in srgb,var(--dpa-c-accent) 78%,#1F6FEB));box-shadow:0 14px 38px -10px color-mix(in srgb,var(--dpa-c-accent) 75%,transparent)}
.dpa-contact__actions > *:nth-child(1){animation-delay:.08s}
.dpa-contact__actions > *:nth-child(2){animation-delay:.14s}
.dpa-contact__actions > *:nth-child(3){animation-delay:.2s}
.dpa-contact__actions > *:nth-child(4){animation-delay:.26s}

/* ---- Blocs ---- */
.dpa-contact__block{padding:20px var(--dpa-pad-x) 0}
.dpa-contact__block--lg{padding-top:24px}
.dpa-contact__eyebrow{margin:0 0 12px;font:600 11.5px/1.3 "Space Grotesk",Helvetica,Arial,sans-serif;letter-spacing:.2em;color:color-mix(in srgb,var(--dpa-c-fg) 42%,transparent)}

/* ---- Encart DPA Tap ---- */
.dpa-contact__promo{display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:18px;background:linear-gradient(120deg,color-mix(in srgb,var(--dpa-c-accent) 12%,#101012),color-mix(in srgb,var(--dpa-c-accent) 7%,transparent) 90%);border:1px solid color-mix(in srgb,var(--dpa-c-accent) 32%,transparent);transition:border-color .25s,transform .15s}
.dpa-contact__promo:hover{border-color:color-mix(in srgb,var(--dpa-c-accent) 60%,transparent);color:var(--dpa-c-fg)}
.dpa-contact__promo:active{transform:scale(.985)}
.dpa-contact__promo-ico{flex:none;width:42px;height:42px;border-radius:13px;background:color-mix(in srgb,var(--dpa-c-accent) 14%,transparent);border:1px solid color-mix(in srgb,var(--dpa-c-accent) 30%,transparent);display:grid;place-items:center;color:var(--dpa-c-accent)}
.dpa-contact__promo-ico svg{width:19px;height:19px}
.dpa-contact__promo-txt{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.dpa-contact__promo-title{font:600 15.5px/1.25 "Space Grotesk",Helvetica,Arial,sans-serif;letter-spacing:-.01em;overflow-wrap:anywhere}
.dpa-contact__promo-sub{font-size:12.5px;line-height:1.4;color:color-mix(in srgb,var(--dpa-c-fg) 55%,transparent);overflow-wrap:anywhere}
.dpa-contact__chev{flex:none;width:16px;height:16px;color:color-mix(in srgb,var(--dpa-c-fg) 45%,transparent)}
.dpa-contact__chev--sm{width:15px;height:15px;color:color-mix(in srgb,var(--dpa-c-fg) 35%,transparent)}

/* ---- Liens ---- */
.dpa-contact__links{display:flex;flex-direction:column;gap:9px}
.dpa-contact__link{display:flex;align-items:center;gap:13px;min-height:60px;padding:13px 16px;border-radius:16px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.075);transition:border-color .25s,background .25s,transform .15s}
.dpa-contact__link:hover{border-color:color-mix(in srgb,var(--dpa-c-accent) 45%,transparent);background:rgba(255,255,255,.055);color:var(--dpa-c-fg)}
.dpa-contact__link:active{transform:scale(.985)}
.dpa-contact__link-ico{flex:none;width:38px;height:38px;border-radius:12px;background:rgba(255,255,255,.05);display:grid;place-items:center;color:var(--dpa-c-accent)}
.dpa-contact__link-ico svg{width:18px;height:18px}
.dpa-contact__link-txt{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.dpa-contact__link-title{font:600 14px/1.3 "Instrument Sans",Helvetica,Arial,sans-serif;overflow-wrap:anywhere}
.dpa-contact__link-sub{font-size:12px;line-height:1.35;color:color-mix(in srgb,var(--dpa-c-fg) 45%,transparent);overflow-wrap:anywhere}

/* ---- Solutions ---- */
.dpa-contact__solutions{display:flex;flex-direction:column;gap:9px}
.dpa-contact__solution{display:flex;gap:13px;align-items:flex-start;padding:15px 16px;border-radius:16px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.075)}
.dpa-contact__solution--accent{background:linear-gradient(120deg,color-mix(in srgb,var(--dpa-c-accent) 9%,rgba(255,255,255,.035)),color-mix(in srgb,var(--dpa-c-accent) 6%,transparent));border-color:color-mix(in srgb,var(--dpa-c-accent) 24%,transparent)}
.dpa-contact__solution-ico{flex:none;width:38px;height:38px;border-radius:12px;background:color-mix(in srgb,var(--dpa-c-accent) 11%,transparent);border:1px solid color-mix(in srgb,var(--dpa-c-accent) 26%,transparent);display:grid;place-items:center;color:var(--dpa-c-accent)}
.dpa-contact__solution-ico--accent{background:color-mix(in srgb,var(--dpa-c-accent) 14%,transparent);border-color:color-mix(in srgb,var(--dpa-c-accent) 32%,transparent)}
.dpa-contact__solution-ico svg{width:18px;height:18px}
.dpa-contact__solution-txt{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px}
.dpa-contact__solution-title{font:600 14.5px/1.25 "Space Grotesk",Helvetica,Arial,sans-serif;letter-spacing:-.01em;overflow-wrap:anywhere}
.dpa-contact__solution-sub{font-size:12.8px;line-height:1.5;color:color-mix(in srgb,var(--dpa-c-fg) 55%,transparent);text-wrap:pretty;overflow-wrap:anywhere}

/* ---- Conversion ---- */
.dpa-contact__cta{position:relative;overflow:hidden;border-radius:20px;border:1px solid color-mix(in srgb,var(--dpa-c-accent) 26%,transparent);background:linear-gradient(150deg,color-mix(in srgb,var(--dpa-c-accent) 10%,#0F0F11),#0B0B0C 62%);padding:24px 22px;text-align:center}
.dpa-contact__cta-orb{position:absolute;top:-80px;right:-60px;width:220px;height:220px;border-radius:50%;background:radial-gradient(closest-side,color-mix(in srgb,var(--dpa-c-accent) 16%,transparent),transparent 72%);pointer-events:none}
.dpa-contact__cta-inner{position:relative}
.dpa-contact__cta-title{margin:0;font:600 21px/1.15 "Space Grotesk",Helvetica,Arial,sans-serif;letter-spacing:-.015em;color:var(--dpa-c-fg);text-wrap:balance}
.dpa-contact__cta-text{margin:10px auto 0;max-width:290px;font-size:13.8px;line-height:1.55;color:color-mix(in srgb,var(--dpa-c-fg) 60%,transparent);text-wrap:pretty}
.dpa-contact__cta-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;margin-top:18px;min-height:48px;max-width:100%;font:600 15px/1.2 "Instrument Sans",Helvetica,Arial,sans-serif;color:var(--dpa-c-bg);background:linear-gradient(140deg,var(--dpa-c-accent),color-mix(in srgb,var(--dpa-c-accent) 78%,#1F6FEB));padding:0 26px;border-radius:999px;box-shadow:0 14px 32px -12px color-mix(in srgb,var(--dpa-c-accent) 70%,transparent);transition:transform .15s,box-shadow .25s}
.dpa-contact__cta-btn svg{width:16px;height:16px;flex:none}
.dpa-contact__cta-btn:hover{color:var(--dpa-c-bg);box-shadow:0 16px 40px -10px color-mix(in srgb,var(--dpa-c-accent) 80%,transparent)}
.dpa-contact__cta-btn:active{transform:scale(.97)}
.dpa-contact__cta-alt{display:flex;justify-content:center;margin-top:12px}
.dpa-contact__cta-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:44px;max-width:100%;font:500 14px/1.2 "Instrument Sans",Helvetica,Arial,sans-serif;color:color-mix(in srgb,var(--dpa-c-fg) 80%,transparent);border:1px solid rgba(255,255,255,.16);padding:0 22px;border-radius:999px;transition:border-color .25s,background .25s}
.dpa-contact__cta-ghost:hover{border-color:color-mix(in srgb,var(--dpa-c-accent) 50%,transparent);background:rgba(255,255,255,.04);color:var(--dpa-c-fg)}

/* ---- À propos ---- */
.dpa-contact__about{margin:0;font-size:14px;line-height:1.7;color:color-mix(in srgb,var(--dpa-c-fg) 62%,transparent);text-wrap:pretty}

/* ---- Coordonnées ---- */
.dpa-contact__rows{border-radius:18px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.075);padding:4px 16px}
.dpa-contact__row{display:flex;align-items:center;gap:13px;min-height:52px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:14px;line-height:1.35;transition:color .2s}
.dpa-contact__rows > *:last-child{border-bottom:0}
.dpa-contact__row svg{flex:none;width:17px;height:17px;color:var(--dpa-c-accent)}
.dpa-contact__row:hover{color:var(--dpa-c-accent)}
.dpa-contact__row--static{color:color-mix(in srgb,var(--dpa-c-fg) 75%,transparent)}
.dpa-contact__row--static:hover{color:color-mix(in srgb,var(--dpa-c-fg) 75%,transparent)}
.dpa-contact__row-wrap{overflow-wrap:anywhere;min-width:0}

/* ---- Formulaire natif (optionnel) ---- */
.dpa-contact__form{border-radius:18px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.075);padding:16px}
.dpa-contact__field + .dpa-contact__field{margin-top:14px}
.dpa-contact__field label{display:block;margin-bottom:6px;font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:color-mix(in srgb,var(--dpa-c-fg) 50%,transparent)}
.dpa-contact__field input,.dpa-contact__field textarea{width:100%;min-height:48px;background:#0d0d0f;border:1px solid rgba(255,255,255,.14);border-radius:12px;color:var(--dpa-c-fg);padding:13px 14px;font:400 16px/1.4 "Instrument Sans",Helvetica,Arial,sans-serif;transition:border-color .2s}
.dpa-contact__field textarea{resize:vertical}
.dpa-contact__field input:focus,.dpa-contact__field textarea:focus{border-color:var(--dpa-c-accent);outline:none}
.dpa-contact__form-btn{margin-top:18px;width:100%;border:0}
.dpa-contact__form-ok{margin:0 0 14px;padding:12px 14px;border-radius:12px;font-size:13px;line-height:1.4;background:color-mix(in srgb,var(--g-green) 14%,transparent);border:1px solid color-mix(in srgb,var(--g-green) 45%,transparent)}
.dpa-contact__form-error{margin:0 0 14px;font-size:13px;line-height:1.4;color:var(--g-red)}

/* ---- Pied de carte ---- */
.dpa-contact__foot{margin-top:26px;border-top:1px solid rgba(255,255,255,.06);padding:24px var(--dpa-pad-x) 30px;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center}
.dpa-contact__foot-logo{height:17px;width:auto;max-width:60%;object-fit:contain;display:block;opacity:.75}
.dpa-contact__foot-name{font:600 12.5px/1.3 "Instrument Sans",Helvetica,Arial,sans-serif;color:color-mix(in srgb,var(--dpa-c-fg) 60%,transparent)}
.dpa-contact__foot-sub{font-size:11.5px;line-height:1.4;letter-spacing:.04em;color:color-mix(in srgb,var(--dpa-c-fg) 38%,transparent);text-wrap:pretty}
.dpa-contact__foot-nfc{display:inline-flex;align-items:center;gap:7px;margin-top:4px;font-size:11px;letter-spacing:.05em;color:color-mix(in srgb,var(--dpa-c-fg) 28%,transparent)}
.dpa-contact__foot-nfc svg{width:11px;height:11px;flex:none}

@keyframes dpaContactUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes dpaContactDot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.82)}}
@media (prefers-reduced-motion:reduce){
  .dpa-contact *,.dpa-contact *::before,.dpa-contact *::after{animation:none!important;transition:none!important}
}

/* Très petits écrans (320 px) : la carte reste lisible et les deux colonnes
   d'actions ne coupent plus les libellés. */
@media (max-width:359px){
  .dpa-contact{--dpa-pad-x:14px}
  .dpa-contact__hero{padding:22px 16px 18px}
  .dpa-contact__name{font-size:26px}
  .dpa-contact__act span{font-size:12.5px}
  .dpa-contact__cta{padding:20px 16px}
}
{% endstylesheet %}

